# Server Port (Default is 3000)
PORT=3000

# Client-Side Socket.IO URL
# In unified single-deployment mode (recommended), leave this empty or unset to automatically use window.location.origin (same-origin).
# If running frontend and backend on separate servers/ports (e.g., dev:split), set this to your backend URL:
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=

# CORS Allowed Origin(s) for Socket.IO
# For single-server unified deployments, CORS is handled on the same origin automatically.
# When deploying frontend and backend to separate domains, specify the allowed frontend origin(s):
# CLIENT_ORIGIN=http://localhost:3000,https://my-chat-frontend.example.com
CLIENT_ORIGIN=

# Environment mode: 'development' or 'production'
NODE_ENV=development
